{
  "module": "23_celtic_lebor_gabala",
  "title": "Complete Irish Lebor Gabála Érenn Part IV: Nemedian Pedigree from Magog, All 9 Fir Bolg Kings & Complete Tuatha Dé Danann Pantheon (Macalister)",
  "nodes": [
    {
      "id": "cel_nemed_pedigree",
      "name": "Irish Universal Pedigree: Noah → Japheth → Magog → Fathacht → Sera → Agnomain → Nemed (Ancestor of Fir Bolg, Britons & Tuatha Dé Danann!)",
      "altNames": [
        "Nemed mac Agnomain",
        "Cessair",
        "Partholón",
        "Iarbonel Fatha",
        "Semeon"
      ],
      "tradition": "europe_norse",
      "tier": 8,
      "era": "Mythic Irish Settlements (Lebor Gabála Érenn R1 ¶316, p. 127)",
      "role": "Bridge Uniting Genesis 10 (Magog) to Ireland's Pre-Milesian Peoples",
      "sources": [
        "Lebor Gabála Érenn Part IV (Macalister ¶280, ¶316, pp. 9, 127)"
      ],
      "notes": "Macalister R1 ¶316 traces Nemed directly from Noah -> Japheth -> Magog -> Fathacht -> Braimend -> Esru -> Sru -> Sera -> Tat -> Pamp -> Agnomain -> Nemed! Nemed's surviving branches produced the Fir Bolg (via Starn -> Semeon -> Dela), the Britons (Britán Máel), and the Tuatha Dé Danann (via Iarbonel the Soothsayer -> Bethach -> Tat)!",
      "major": true,
      "biblicalConnected": true
    },
    {
      "id": "cel_fir_bolg_kings",
      "name": "Complete Fir Bolg Dynasty (Dela's 5 Sons & All 9 Kings): Sláine, Rudraige, Gann, Genann, Sengann → Fiacha → Rindail → Fodbgenid → Eochu mac Eirc (+ Queen Tailtiu)",
      "altNames": [
        "Dela",
        "Sláine",
        "Eochu mac Eirc",
        "Queen Tailtiu"
      ],
      "tradition": "europe_norse",
      "tier": 9,
      "era": "Pre-Tuatha Dé Ireland (Lebor Gabála Part IV Sect. VI, pp. 7-21)",
      "role": "First Organizers of Ireland's Five Provinces & Tailteann Games",
      "sources": [
        "Lebor Gabála Érenn Part IV (Macalister ¶278-289, pp. 7-21)"
      ],
      "notes": "Dela's 5 sons & 5 wives (Sláine+Fuat, Gann+Etar, Sengann+Anust, Genann+Cnucha, Rudraige+Liber) divided Ireland into its 5 provinces (Cóiceda). Last king Eochu mac Eirc married Spanish princess Tailtiu (foster-mother of Lugh!) before falling at 1st Battle of Mag Tuired.",
      "major": true,
      "biblicalConnected": true
    },
    {
      "id": "cel_tdd_nuadu_dian_cecht",
      "name": "Tuatha Dé Danann Line A & B1: Nuadu Airgetlám ('Silver Hand'), Midir & Esarg's 4 Sons (Goibniu, Creidne, Luichtne & Dian Cécht → Cian + Ethniu → Lugh Lámfada!)",
      "altNames": [
        "Nuadu Airgetlám",
        "Dian Cécht",
        "Goibniu",
        "Balor of the Evil Eye",
        "Lugh Lámfada"
      ],
      "tradition": "europe_norse",
      "tier": 10,
      "era": "Battle of Mag Tuired (Lebor Gabála Part IV Sect. VII, pp. 113-159)",
      "role": "Silver-Handed King Nuadu, Divine Craftsmen & Hero-King Lugh Lámfada",
      "sources": [
        "Lebor Gabála Érenn Part IV (Macalister ¶310-316, ¶341, pp. 113-159)"
      ],
      "notes": "Nuadu Airgetlám ruled 27 yrs after healer Dian Cécht & Creidne forged his silver hand. Dian Cécht's son Cian married Ethniu (daughter of Fomorian King Balor of the Evil Eye!), fathering Lugh Lámfada ('Long-Arm', master of all arts!), who slew grandfather Balor at 2nd Mag Tuired and reigned 40 yrs!",
      "major": true,
      "biblicalConnected": true
    },
    {
      "id": "cel_tdd_dagda_ogma_eriu",
      "name": "Tuatha Dé Danann Line B2 (Elada's Sons): The Dagda (Eochu Ollathair → Óengus Mac Óc, Brigit & Cermait → Mac Cuill/Mac Cécht/Mac Gréine) & Ogma (→ Delbaeth → Ériu, Banba, Fódla & 3 Sons of Danu)",
      "altNames": [
