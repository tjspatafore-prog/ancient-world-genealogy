      "altNames": [
        "Hevel",
        "Habil"
      ],
      "tradition": "biblical",
      "tier": 2,
      "era": "Antediluvian Gen 2",
      "role": "Second Son of Adam & Eve",
      "sources": [
        "Genesis 4:2-8",
        "Jubilees 4:1-4",
        "Book of Jasher 1:12-25"
      ],
      "notes": "Shepherd slain by Cain. In Jasher 1:13-25 the conflict involves the division of fields, flocks, and twin sisters.",
      "major": false
    },
    {
      "id": "bib_cain",
      "name": "Cain (Qayin) & Awan",
      "altNames": [
        "Qayin",
        "Wife: Awan (Jub 4:9)"
      ],
      "tradition": "biblical",
      "tier": 2,
      "era": "Antediluvian Gen 2",
      "role": "Firstborn / Builder of City of Enoch",
      "sources": [
        "Genesis 4:1-17",
        "Jubilees 4:9",
        "Book of Jasher 1"
      ],
      "notes": "Founder of the Cainite line. Jubilees 4:9 names his wife Awan (his sister). Jasher 2:26-27 recounts his accidental death by blind Lamech's arrow.",
      "major": true
    },
    {
      "id": "bib_seth",
      "name": "Seth (Shet) & Azura",
      "altNames": [
        "Shet",
        "Wife: Azura (Jub 4:11)"
      ],
      "tradition": "biblical",
      "tier": 2,
      "era": "Antediluvian Gen 2",
      "role": "Sethite Patriarch",
      "sources": [
        "Genesis 4:25, 5:3",
        "Jubilees 4:11",
        "Book of Jasher 2:1",
        "Josephus Ant. 1.2.3"
      ],
      "notes": "Appointed in place of Abel. Jubilees 4:11 names his wife Azura. Josephus credits Seth's descendants with inventing astronomy and inscribing it on two pillars to survive flood and fire.",
      "major": true
    },
