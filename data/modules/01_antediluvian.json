    {
      "id": "bib_tubalcain",
      "name": "Tubal-cain",
      "altNames": [],
      "tradition": "biblical",
      "tier": 3,
      "era": "Antediluvian Gen 8 (Cainite)",
      "role": "Master of Bronze & Iron Metallurgy",
      "sources": [
        "Genesis 4:22",
        "Book of Jasher 2:25-27"
      ],
      "notes": "Son of Lamech & Zillah. Jasher 2:26-27 relates how he guided blind Lamech's bow, accidentally killing Cain before being slain by Lamech.",
      "major": false
    },
    {
      "id": "bib_naamah_cain",
      "name": "Naamah (dau. of Lamech)",
      "altNames": [],
      "tradition": "biblical",
      "tier": 3,
      "era": "Antediluvian Gen 8 (Cainite)",
      "role": "Sister of Tubal-cain",
      "sources": [
        "Genesis 4:22",
        "Genesis Rabbah 23:3"
      ],
      "notes": "Named in Genesis 4:22. Rabbinic tradition (Genesis Rabbah 23:3) identifies her as Noah's wife (while Book of Jasher 5:15 names Noah's wife as Naamah daughter of Enoch).",
      "major": false
    },
    {
      "id": "bib_enosh",
      "name": "Enosh & Noam",
      "altNames": [
        "Enos",
        "Wife: Noam (Jub 4:13)"
