    {
      "id": "bib_adam",
      "name": "Adam & Eve (Hawwah)",
      "altNames": [
        "Adamah",
        "Hawwah"
      ],
      "tradition": "biblical",
      "tier": 1,
      "era": "Creation (Gen 1-5)",
      "role": "Primeval Progenitors",
      "sources": [
        "Genesis 2-5",
        "Jubilees 3-4",
        "Book of Jasher 1"
      ],
      "notes": "First human couple. Book of Jasher 1:12-13 notes they bore two sons (Cain, Abel) and three daughters; Jubilees 4 explicitly names their daughters Awan and Azura.",
      "major": true
    },
    {
