    },
    {
      "id": "bib_enoch",
      "name": "Enoch (Khanokh) & Edni",
      "altNames": [
        "Idris (Arabic)",
        "Thoth / Hermes (Syncretic)",
        "King Saurid (Egyptian-Arabic lore)",
        "Wife: Edni (Jub 4:20)"
      ],
      "tradition": "biblical",
      "tier": 3,
      "era": "Antediluvian Gen 7 (365 yrs)",
      "role": "7th Patriarch / Scribe of Righteousness",
      "sources": [
        "Genesis 5:21-24",
        "1 Enoch 1-108",
        "Jubilees 4:17-25",
        "Book of Jasher 3"
      ],
      "notes": "7th from Adam; lived 365 years and ascended to heaven. Jubilees 4:17 credits him as first to learn writing, calendar, and astronomy. Book of Jasher 3:1 names his 3 sons (Methuselah, Elisha, Elimelech) and 2 daughters (Melca, Nahmah/Naamah). Widely equated in Greco-Egyptian & Arabic lore with Thoth/Hermes/King Saurid and compared to 7th Sumerian king Enmeduranki!",
      "major": true
    },
    {
      "id": "bib_methuselah",
      "name": "Methuselah & Edna",
      "altNames": [
        "Metushelach",
        "Wife: Edna (Jub 4:27)"
      ],
      "tradition": "biblical",
      "tier": 3,
      "era": "Antediluvian Gen 8 (969 yrs)",
      "role": "8th Patriarch / Longest-Lived",
      "sources": [
        "Genesis 5:25-27",
        "1 Enoch 82 & 106",
        "Jubilees 4:27",
        "Book of Jasher 3-5"
      ],
      "notes": "Custodian of Enoch's books. Jubilees 4:27 names his wife Edna. Jasher 5:35 also names his son Eliakim, whose 3 daughters marry Noah's 3 sons!",
      "major": true
    },
    {
